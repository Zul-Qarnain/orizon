# Mistral LLM. Extra keys are tried on 429/401/403; recently limited keys are skipped.
MISTRAL_API_KEY=
MISTRAL_API_KEYS=
MISTRAL_MODEL=mistral-small-latest
# Optional. Server-side LLM budget in ms (default 1400). Regex fallback after that.
LLM_TIMEOUT_MS=1400

# HTTP Server Host and Port
HOST=0.0.0.0
PORT=3000
