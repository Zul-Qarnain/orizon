{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@gridwise/shared-types": ["./packages/shared-types/src/index.ts"],
      "@gridwise/guardrails": ["./packages/guardrails/src/index.ts"],
      "@gridwise/llm-interpreter": ["./packages/llm-interpreter/src/index.ts"],
      "@gridwise/optimizer": ["./packages/optimizer/src/index.ts"],
      "@gridwise/schedule-validator": ["./packages/schedule-validator/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
